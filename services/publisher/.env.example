# Copy to .env (git-ignored) and fill in. Every variable is optional: with none set the publisher
# runs, reads the game server, and writes nothing (it says so once in the log).

# --- the game server -----------------------------------------------------------------------------
SERVER_URL=http://127.0.0.1:7878
POLL_INTERVAL_MS=15000
CITY_TIMEOUT_MS=5000

# --- Arkiv (Rabdi testnet, chain id 7794095) -------------------------------------------------------
# The writer key. Fund its address with tGLM at https://hub.arkiv.network/faucet (`npm run address` prints it).
ARKIV_PRIVATE_KEY=
# Free RPC access key from https://hub.arkiv.network/access-keys. Empty = the public, heavily rate-limited RPC.
ARKIV_ACCESS_KEY=
# rabdi (default) or localhost; ARKIV_RPC_URL overrides the chain's RPC URL.
ARKIV_CHAIN=rabdi
ARKIV_RPC_URL=
# Read-only publisher (no key): whose entities the read API trusts.
ARKIV_WRITER_ADDRESS=
ARKIV_FLUSH_INTERVAL_MS=20000
ARKIV_MAX_OPS_PER_TX=12
ARKIV_TX_TIMEOUT_MS=120000
ARKIV_QUERY_TIMEOUT_MS=15000
# The `env` attribute on every entity: keeps rehearsal and live data apart in queries.
PUBLISHER_ENV=dev

# --- Swarm (a Bee node and a postage batch) -------------------------------------------------------
BEE_URL=
BEE_POSTAGE_BATCH=
BEE_PIN=true
BEE_DEFERRED_UPLOAD=true
BEE_TIMEOUT_MS=60000

# --- the read API ----------------------------------------------------------------------------------
PUBLISHER_HOST=127.0.0.1
PUBLISHER_PORT=8787
READ_CACHE_MS=10000
# Comma list of origins allowed to call the API from a browser, or *.
CORS_ORIGINS=*
UPLOADS_PER_HOUR=12
UPLOADS_PER_DAY=200

# --- bookkeeping -------------------------------------------------------------------------------------
PUBLISHER_STATE_DIR=data
PRICE_BATCH_MS=300000
PROFILE_FALLBACK_DAYS=7
LOG_LEVEL=info
