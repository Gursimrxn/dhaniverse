class_name VHTex
extends RefCounted
## Verdant Horizon textures, generated by the reference's own authoring code (textures.ts) and
## exported byte-for-byte (assets/vh/*.rgba.gz, RGBA8 rows in three.js order, so texture(t, uv)
## returns the same texel in both engines). Leaf atlases carry their coverage-preserving mips.

const DIR := "res://assets/vh/"
static var _meta := {}
static var _cache := {}

## Whether a texture is in the set (the generated foliage, tools/gen_foliage.py, may not have been built).
static func has(tex_name: String) -> bool:
	if _meta.is_empty(): _meta = JSON.parse_string(FileAccess.get_file_as_string(DIR + "textures.json"))
	return _meta.has(tex_name) and FileAccess.file_exists(DIR + tex_name + ".rgba.gz")

static func get_tex(tex_name: String) -> ImageTexture:
	if _cache.has(tex_name): return _cache[tex_name]
	if _meta.is_empty(): _meta = JSON.parse_string(FileAccess.get_file_as_string(DIR + "textures.json"))
	var key := tex_name if _meta.has(tex_name) else tex_name.trim_suffix("_map").trim_suffix("_normal")
	var m: Array = _meta[key]
	var w := int(m[0])
	var h := int(m[1])
	var mips := m.size() > 2
	var size := 0
	var lw := w
	var lh := h
	while true:
		size += lw * lh * 4
		if not mips or (lw == 1 and lh == 1): break
		lw = maxi(1, lw >> 1)
		lh = maxi(1, lh >> 1)
	var data := FileAccess.get_file_as_bytes(DIR + tex_name + ".rgba.gz").decompress(size, FileAccess.COMPRESSION_GZIP)
	var img := Image.create_from_data(w, h, mips, Image.FORMAT_RGBA8, data)
	if not mips: img.generate_mipmaps()
	var t := ImageTexture.create_from_image(img)
	_cache[tex_name] = t
	return t

## The lamps lit around the player, for vh.gdshaderinc's vh_lamps: each one's position + range and its linear colour x
## intensity (Colors), up to LAMP_MAX, as a LAMP_MAX x 2 float texture (global vh_lamp_tex), with their count in vh_lamp_n.
const LAMP_MAX := 12
static var _lamp_img: Image
static var _lamp_tex: ImageTexture

static func set_lamps(pos: Array, col: Array) -> void:
	if _lamp_tex == null:
		_lamp_img = Image.create(LAMP_MAX, 2, false, Image.FORMAT_RGBAF)
		_lamp_tex = ImageTexture.create_from_image(_lamp_img)
	RenderingServer.global_shader_parameter_set("vh_lamp_tex", _lamp_tex)
	var n := mini(pos.size(), LAMP_MAX)
	for i in n:
		_lamp_img.set_pixel(i, 0, pos[i])
		_lamp_img.set_pixel(i, 1, col[i])
	if n > 0: _lamp_tex.update(_lamp_img)
	RenderingServer.global_shader_parameter_set("vh_lamp_n", n)
